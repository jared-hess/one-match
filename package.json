{
  "name": "one-match",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node --experimental-global-webcrypto ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "cap:sync": "capacitor sync",
    "android:open": "capacitor open android",
    "android:run": "capacitor run android",
    "android:setup:check": "bash scripts/android/setup-linux.sh --check",
    "android:setup:install": "bash scripts/android/setup-linux.sh --install",
    "android:build:debug": "bash scripts/android/build-debug.sh",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "ci": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.1",
    "@capacitor/haptics": "6.0.2",
    "@capacitor/share": "6.0.3",
    "@supabase/supabase-js": "2.75.0",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "latest",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "husky": "^9.1.7",
    "jsdom": "24.1.3",
    "lint-staged": "^15.5.2",
    "postcss": "latest",
    "prettier": "^3.8.4",
    "tailwindcss": "3.4.17",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "5.4.21",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.9"
  }
}
